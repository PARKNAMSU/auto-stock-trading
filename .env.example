# 애플리케이션 실행에 필요한 환경 변수의 예시입니다. 실제 비밀값은 커밋하지 않습니다.
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
TOSSINVEST_ACCOUNT=
TOSSINVEST_BASE_URL=https://openapi.tossinvest.com
TRADING_MODE=dry-run
TRADING_MARKET=us
MAX_ORDER_AMOUNT=100000

# development: 로컬 27017, test: 로컬 27018, production: MONGODB_URI 필수
APP_ENV=development
# 비워두면 APP_ENV의 기본 주소를 사용합니다. 운영 값은 비밀 관리 시스템에서 주입합니다.
MONGODB_URI=
MONGODB_CONNECT_TIMEOUT=5s
MONGODB_OPERATION_TIMEOUT=5s
MONGODB_SHUTDOWN_TIMEOUT=5s
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=20
